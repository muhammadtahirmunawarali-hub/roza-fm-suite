DATABASE_URL=file:/home/z/my-project/db/custom.db

# Show demo quick-login buttons on the login page (dev/staging only).
# Set to "false" or remove this line entirely for production.
NEXT_PUBLIC_SHOW_DEMO_LOGIN=true

# ─────────────────────────────────────────────────────────────
# PRODUCTION ENV VARS (set these on Vercel before going live)
# ─────────────────────────────────────────────────────────────

# Database (Neon Postgres — see Step 7 of the launch guide)
# DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/roza_fm?sslmode=require"

# Cloudflare R2 (file storage — WO attachments, images)
# R2_ACCOUNT_ID="your-account-id"
# R2_ACCESS_KEY_ID="your-access-key"
# R2_SECRET_ACCESS_KEY="your-secret"
# R2_BUCKET_NAME="roza-fm-uploads"
# R2_PUBLIC_URL="https://uploads.yourdomain.com"

# Stripe (real billing)
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_PUBLISHABLE_KEY="pk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_STARTER="price_..."
# STRIPE_PRICE_PRO="price_..."
# STRIPE_PRICE_ENTERPRISE="price_..."

# Resend (transactional email)
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Roza FM Suite <noreply@yourdomain.com>"
