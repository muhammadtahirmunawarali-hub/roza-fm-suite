// Roza FM Suite — Prisma Schema
// Dynamic Register & Form Builder architecture.
// Registers are schema-driven (columns stored as JSON), records are JSON blobs.
// This keeps the FMCore DNA while giving us a real relational DB ready for SaaS migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// CORE: Dynamic Registers (schema-driven "tables")
// ============================================================

model Register {
  id          String   @id @default(cuid())
  code        String   // url-friendly slug, e.g. "workorders" (unique per-tenant, see @@unique below)
  name        String
  icon        String   @default("fa-table") // Font Awesome icon name
  category    String   @default("operations") // operations|maintenance|safety|assets|procurement|hr|performance|admin
  color       String   @default("#00D4AA")
  description String?
  // columns is a JSON array of column definitions:
  // [{ name, type, width, options?, required?, default? }]
  // type: auto_increment|text|long_text|number|currency|percentage|date|datetime|time|
  //       dropdown|status|priority|multi_select|email|phone|rating|employee|department|
  //       building|asset|equipment|vendor
  columns     String   @default("[]") // JSON
  isSystem    Boolean  @default(false) // system registers can't be deleted
  isDeleted   Boolean  @default(false)
  order       Int      @default(0)
  tenantId    String?  // SaaS: null = shared platform/system register (Super Admin), otherwise tenant-scoped
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  records     Record[]
  auditLogs   AuditLog[]

  @@index([tenantId])
  @@unique([tenantId, code]) // same code allowed across tenants; NULLs are distinct in SQLite so system register (null) is unique
}

model Record {
  id           String   @id @default(cuid())
  registerId   String
  register     Register @relation(fields: [registerId], references: [id], onDelete: Cascade)
  // sequence is used for auto_increment columns (e.g. WO-001, WO-002)
  sequence     Int      @default(0)
  // data is a JSON object keyed by column name
  // { "Date": "2025-02-10", "Status": "Open", "Priority": "High", ... }
  data         String   @default("{}") // JSON
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?
  updatedBy    String?
  tenantId     String?  // SaaS: null = shared platform/system data (Super Admin), otherwise tenant-scoped

  @@index([registerId])
  @@index([registerId, isDeleted])
  @@index([tenantId])
}

// ============================================================
// ADMINISTRATION
// ============================================================

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  username    String   @unique
  password    String   // plaintext for demo only — replace with hashed in production
  role        String   @default("Administrator") // Super Admin|Administrator|Manager|Accountant|...
  branch      String?
  department  String?
  avatar      String?  // initials or url
  status      String   @default("Active") // Active|Inactive|Suspended
  permissions String   @default("[]") // JSON array of {module, actions[]}
  tenantId    String?  // SaaS: links user to a tenant company (null = Super Admin / system user)
  mustChangePassword Boolean @default(false) // true = force password change on next login (for email-based onboarding)
  lastLoginAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  auditLogs   AuditLog[]
  sessions    Session[]

  @@index([tenantId])
}

// ============================================================
// SESSIONS (login tracking for simulated auth)
// ============================================================

model Session {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String   @unique // session token (stored in cookie)
  ipAddress   String?
  userAgent   String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================
// SAVED VIEWS (user-specific saved filters per register)
// ============================================================

model SavedView {
  id          String   @id @default(cuid())
  name        String
  registerId  String   // register this view belongs to
  userId      String?  // owner; null = shared/system
  filters     String   @default("{}") // JSON: { search, filters, sortField, sortDir }
  isShared    Boolean  @default(false)
  tenantId    String?  // SaaS scoping
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([registerId])
  @@index([userId])
  @@index([tenantId])
}

// ============================================================
// USER DASHBOARD PREFERENCES (pin/hide/reorder KPIs & charts)
// ============================================================

model UserDashboardPref {
  id          String   @id @default(cuid())
  userId      String   @unique // one preference row per user
  pinnedKpis  String   @default("[]") // JSON array of KPI ids to show (empty = all)
  hiddenKpis  String   @default("[]") // JSON array of KPI ids to hide
  kpiOrder    String   @default("[]") // JSON array of KPI ids in custom order
  pinnedCharts String  @default("[]") // JSON array of chart ids to show
  hiddenCharts String  @default("[]") // JSON array of chart ids to hide
  chartOrder  String   @default("[]") // JSON array of chart ids in custom order
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String   // Created|Updated|Deleted|Approved|Cancelled|Logged In|Exported|Imported
  module      String   // register name or "Auth" / "Settings" / "Backup"
  registerId  String?
  register    Register? @relation(fields: [registerId], references: [id], onDelete: SetNull)
  recordId    String?
  oldValue     String?  // JSON snapshot
  newValue     String?  // JSON snapshot
  summary     String   // human-readable
  ip          String?
  tenantId    String?  // SaaS scoping
  createdAt   DateTime @default(now())

  @@index([module])
  @@index([createdAt])
  @@index([userId])
  @@index([tenantId])
}

// ============================================================
// SETTINGS (key-value store)
// ============================================================

model Setting {
  key         String   @id // e.g. "theme", "currency", "company.name", "numbering.WO"
  value       String   @default("") // JSON-encoded value
  category    String   @default("general") // general|company|currency|tax|invoice|numbering|appearance|notifications
  updatedAt   DateTime @updatedAt
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id          String   @id @default(cuid())
  type        String   // low_stock|overdue_invoice|pending_approval|work_order_overdue|maintenance_due|task_due|system
  title       String
  message     String
  severity    String   @default("info") // info|warning|critical|success
  link        String?  // url to navigate to
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  readAt      DateTime?

  @@index([isRead])
  @@index([createdAt])
}

// ============================================================
// OPEN TABS (persisted client-side tabs across refreshes)
// ============================================================

model OpenTab {
  id          String   @id @default(cuid())
  tabId       String   @unique // client tab id
  type        String   // dashboard|register|settings|reports|audit
  label       String
  icon        String
  refId       String?  // register id if type=register
  order       Int      @default(0)
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ============================================================
// STOCK MOVEMENTS (inventory consumption linked to work orders)
// When a technician consumes material on a WO, stock reduces
// and a movement record is created linking WO → Item → Qty.
// ============================================================

model StockMovement {
  id            String   @id @default(cuid())
  // What moved
  itemDescription String // description of the inventory item
  // Movement details
  movementType  String   // issue_to_wo | return_to_stock | adjustment_in | adjustment_out | transfer
  quantity      Float    @default(0)
  // Link to work order (if issue_to_wo)
  woRegisterId  String?  // register id of the work order
  woRecordId    String?  // record id of the work order
  woSequence    Int?     // WO number for display
  // Link to inventory register (if applicable)
  invRegisterId String?
  invRecordId   String?
  // Who and when
  movedBy       String?
  note          String?
  tenantId      String?  // SaaS scoping
  createdAt     DateTime @default(now())

  @@index([woRecordId])
  @@index([movementType])
  @@index([createdAt])
  @@index([tenantId])
}

// ============================================================
// TENANTS (SaaS multi-tenancy)
// ============================================================

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  plan        String   @default("starter")
  status      String   @default("active")
  stripeCustomerId String?
  stripeSubId String?
  maxUsers    Int      @default(10)
  maxRecords  Int      @default(10000)
  maxStorageMb Int     @default(1024) // storage limit in MB (default 1GB)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// API KEYS (Public REST API authentication)
// ============================================================

model ApiKey {
  id          String   @id @default(cuid())
  key         String   @unique @default(cuid())
  name        String
  permissions String   @default("[]")
  rateLimit   Int      @default(100)
  tenantId    String?  // SaaS: scopes API key to a tenant (null = platform-level)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model WebhookConfig {
  id          String   @id @default(cuid())
  url         String
  events      String   @default("[]")
  secret      String?
  isActive    Boolean  @default(true)
  description String?
  lastTriggeredAt DateTime?
  failureCount Int    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WebhookLog {
  id          String   @id @default(cuid())
  webhookId   String
  event       String
  payload     String
  statusCode  Int?
  response    String?
  success     Boolean
  duration    Int?
  createdAt   DateTime @default(now())
}
